# Copie para .env. O docker compose da raiz lê este arquivo.

# Senha do Neo4j (8+ caracteres). O usuário é neo4j (NEO4J_USER muda).
NEO4J_PASSWORD=graphpassword

# Origens que podem chamar as consultas REST do navegador, separadas por vírgula. Vazio: só o console
# (http://localhost:<WEB_PORT>). Ex.: outra aplicação que consulte o grafo pelo navegador.
CORS_ORIGINS=

# Opcional: link das evidências no console, no formato repo@sha:caminho, com {repo}, {sha} e {path}.
# Ex.: http://gitlab.example.com/{repo}/-/blob/{sha}/{path}
VITE_EVIDENCE_URL_TEMPLATE=

# Portas no host (padrões: API 3200, console 5180, Neo4j 7474 e 7687).
# API_PORT=3200
# WEB_PORT=5180
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687

# Retenção: dias do retrato congelado depois de sair dos ambientes e do histórico de deploys; intervalo da limpeza
# em minutos (0 desliga).
# FROZEN_RETENTION_DAYS=30
# DEPLOY_HISTORY_DAYS=30
# DEPLOY_HISTORY_DAYS_PRODUCTION=365
# RETENTION_INTERVAL_MINUTES=60

# Autenticação. Sem OIDC_ISSUER, a instância é anônima: o console abre sem login e quem alcança a API consulta o grafo.
# Use assim só para avaliação ou numa rede de confiança.
#
# Token fixo dos adaptadores (16+ caracteres): no modo anônimo, a escrita (ingestão, apelidos, união) passa a exigi-lo
# em Authorization: Bearer. Gere com: openssl rand -base64 32
# INGEST_TOKEN=
#
# Login pelo SSO da organização (OIDC: Entra ID, Okta, Keycloak, Google...). Registre um aplicativo web no provedor
# com o retorno <API_PUBLIC_URL>/v1/auth/callback e o logout voltando para o console.
# API_PUBLIC_URL=http://localhost:3200           # endereço da API visto pelo navegador
# OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=                            # vazio: cliente público, só com PKCE
# OIDC_SCOPES=openid profile email
# OIDC_GROUPS_CLAIM=groups                       # claim com os grupos da pessoa
# SESSION_SECRET=                                # 32+ caracteres, igual em todas as réplicas: openssl rand -base64 48
# SESSION_TTL_HOURS=8
# SESSION_COOKIE_SAMESITE=lax                    # none quando console e API ficam em sites diferentes (exige HTTPS)
#
# Tokens de serviço (adaptadores, CI, clientes MCP): JWTs desses emissores, com a audiência JWT_AUDIENCE, valem em
# Authorization: Bearer. Ex.: o próprio provedor (client credentials) e o OIDC do CI (https://gitlab.example.com).
# JWT_ISSUERS=
# JWT_AUDIENCE=panorama-graph
#
# Keycloak de exemplo (docker compose --profile sso up -d --build). Descomente as linhas abaixo.
# OIDC_ISSUER=http://localhost:8180/realms/panorama
# OIDC_DISCOVERY_URL=http://keycloak:8080/realms/panorama/.well-known/openid-configuration
# OIDC_ALLOW_HTTP=true
# OIDC_CLIENT_ID=panorama-graph
# OIDC_CLIENT_SECRET=panorama-graph-dev-secret
# SESSION_SECRET=troque-por-um-segredo-de-32-caracteres-ou-mais
# JWT_ISSUERS=http://localhost:8180/realms/panorama
# KEYCLOAK_PORT=8180
