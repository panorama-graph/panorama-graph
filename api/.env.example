# Copie para .env. A API e o docker compose leem este arquivo.
NODE_ENV=development
LOG_LEVEL=info
API_PORT=3200
# Origens que podem chamar as consultas REST (`POST /queries/...`) do navegador, separadas por vírgula.
# Ex.: o console local (5180). Vazio: nenhuma.
CORS_ORIGINS=http://localhost:5180

# Neo4j de desenvolvimento (serviço `neo4j` do docker compose). A senha precisa ter 8+ caracteres.
# Dentro do compose, a API usa bolt://neo4j:7687 (sobrescrito no docker-compose.yml).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphpassword
NEO4J_DATABASE=neo4j

# Neo4j de teste (serviço `neo4j-test`, perfil `test`, dados em memória). Usado só pelos testes (`pnpm test`),
# que apagam tudo entre um teste e outro: nunca aponte para o banco de desenvolvimento.
NEO4J_TEST_URI=bolt://localhost:7688
NEO4J_TEST_PASSWORD=testpassword
# Retenção: dias do retrato congelado depois de sair dos ambientes e do histórico de deploys; intervalo da limpeza (0 desliga)
FROZEN_RETENTION_DAYS=30
DEPLOY_HISTORY_DAYS=30
DEPLOY_HISTORY_DAYS_PRODUCTION=365
RETENTION_INTERVAL_MINUTES=60

# Autenticação (detalhes no .env.example da raiz). Sem OIDC_ISSUER, a instância é anônima.
# INGEST_TOKEN=
# Keycloak de exemplo (docker compose --profile sso up -d keycloak), com a API rodando fora do compose:
# OIDC_ISSUER=http://localhost:8180/realms/panorama
# OIDC_CLIENT_ID=panorama-graph
# OIDC_CLIENT_SECRET=panorama-graph-dev-secret
# SESSION_SECRET=troque-por-um-segredo-de-32-caracteres-ou-mais
# JWT_ISSUERS=http://localhost:8180/realms/panorama
