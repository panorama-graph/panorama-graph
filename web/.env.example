# Copie para .env. O Vite embute estas variáveis no build: o navegador chama a API direto.
# REST do panorama-graph-api. A origem deste console (http://localhost:5180) precisa estar no CORS_ORIGINS dele.
VITE_GRAPH_API_URL=http://localhost:3200
# Opcional: link das evidências no formato repo@sha:caminho. Marcadores {repo}, {sha} e {path}; a linha, quando
# a evidência traz, entra como #L<linha>. Ex.: GitLab local da organização de teste.
VITE_EVIDENCE_URL_TEMPLATE=
